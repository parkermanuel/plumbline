{
  "appId": "com.parkermanuel.plumbline",
  "appName": "Plumbline",
  "webDir": "app-shell",
  "server": {
    "url": "https://joinplumbline.com",
    "allowNavigation": [
      "joinplumbline.com",
      "*.joinplumbline.com",
      "plumblineassessment.com",
      "*.plumblineassessment.com",
      "plumblineteams.com",
      "*.plumblineteams.com",
      "msjmhbggcwwppqzfkxug.supabase.co"
    ],
    "errorPath": "offline.html"
  },
  "appendUserAgent": "PlumblineApp/1",
  "backgroundColor": "#121212",
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false,
    "scrollEnabled": true
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#121212",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DEFAULT"
    }
  }
}
